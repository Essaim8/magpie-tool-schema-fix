{
  "name": "magpie-tool-schema-fix",
  "version": "0.2.0",
  "description": "Magpie gateway middleware that adds missing object types to tool JSON Schemas for the models it names (yetone/magpie#2179)",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Essaim8/magpie-tool-schema-fix.git"
  },
  "keywords": [
    "magpie-plugin",
    "magpie-middleware",
    "json-schema",
    "codex",
    "tool-schema"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "magpie": {
    "middleware": "./tool-schema-fix.middleware.js",
    "options": {
      "models": [
        "mirasim/gemini-4-argon"
      ],
      "agents": []
    }
  }
}
